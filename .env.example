# Copy to .env and fill in (never commit .env).
# NASA Earthdata login (https://urs.earthdata.nasa.gov) - NISAR GCOV reads in step 02
EARTHDATA_USER=
EARTHDATA_PASS=
# Optional alternative to user/pass: an Earthdata bearer token
# EARTHDATA_TOKEN=
# Google Earth Engine cloud project - only for pipeline/06_baseline_s1_gee.py
# (run `earthengine authenticate` once). The default Sentinel-1 backend
# (Planetary Computer) needs no account.
GEE_PROJECT=
