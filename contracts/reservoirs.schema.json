{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract 1 - reservoirs.geojson (Track A -> B, C, D)",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "metadata": {"type": "object"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": {"const": "Feature"},
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {"type": {"enum": ["Polygon", "MultiPolygon"]}}
          },
          "properties": {
            "type": "object",
            "required": ["reservoir_id", "name", "basin", "capacity_mcm", "dam_year", "polygon_area_km2", "priority", "confidence"],
            "properties": {
              "reservoir_id": {"type": "string", "pattern": "^[A-Z]{3}_[0-9]{4}$"},
              "name": {"type": "string", "minLength": 1},
              "basin": {"type": ["string", "null"]},
              "capacity_mcm": {"type": ["number", "null"], "minimum": 0},
              "dam_year": {"type": ["integer", "null"]},
              "polygon_area_km2": {"type": "number", "minimum": 0},
              "priority": {"type": "boolean"},
              "confidence": {"enum": ["high", "low"]},
              "monitored": {"type": "boolean"},
              "month": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$"},
              "status": {"enum": ["above_normal", "normal", "watch", "drought", "severe", "no_data", null]}
            }
          }
        }
      }
    }
  }
}
