{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract 4 - timeseries/<reservoir_id>.json (Track A -> D)",
  "type": "object",
  "required": ["reservoir_id", "series"],
  "properties": {
    "reservoir_id": {"type": "string", "pattern": "^[A-Z]{3}_[0-9]{4}$"},
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["month", "area_km2", "normal_km2", "p10_km2", "p90_km2", "status", "sensor", "official_fill_pct"],
        "properties": {
          "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
          "area_km2": {"type": ["number", "null"]},
          "normal_km2": {"type": ["number", "null"]},
          "p10_km2": {"type": ["number", "null"]},
          "p90_km2": {"type": ["number", "null"]},
          "pct_of_normal": {"type": ["number", "null"]},
          "z_score": {"type": ["number", "null"]},
          "status": {"enum": ["above_normal", "normal", "watch", "drought", "severe", "no_data"]},
          "sensor": {"enum": ["NISAR", "S1"]},
          "n_obs": {"type": ["integer", "null"]},
          "quality": {"enum": ["good", "partial", "bad", null]},
          "official_fill_pct": {"type": ["number", "null"]},
          "mom_change_pct": {"type": ["number", "null"]},
          "yoy_change_pct": {"type": ["number", "null"]}
        }
      }
    }
  }
}
